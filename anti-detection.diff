     smbios_have_defaults = true;
 
+    /* Local analysis build: provide BIOS (type 0) strings so the guest does
+     * not see firmware-supplied "SeaBIOS"/"EDK II"/OVMF values. Not upstream. */
+    SMBIOS_SET_DEFAULT(smbios_type0.vendor, "LENOVO");
+    SMBIOS_SET_DEFAULT(smbios_type0.version, "N2WET30W (1.20 )");
+    SMBIOS_SET_DEFAULT(smbios_type0.date, "06/30/2020");
+
     SMBIOS_SET_DEFAULT(smbios_type1.manufacturer, manufacturer);
     SMBIOS_SET_DEFAULT(smbios_type1.product, product);
     SMBIOS_SET_DEFAULT(smbios_type1.version, version);
